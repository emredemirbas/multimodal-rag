FROM python:3.12.10-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 \
    OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=1 TOKENIZERS_PARALLELISM=false

RUN apt-get update && apt-get install -y --no-install-recommends libseccomp2 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 1000 asr && useradd --uid 1000 --gid 1000 --home-dir /app asr \
    && install -d -o 1000 -g 1000 /app /models

WORKDIR /app
COPY pyproject.toml setup.cfg ./
COPY app ./app
RUN pip install --no-cache-dir '.[asr]'

USER 1000:1000
EXPOSE 8090
CMD ["python", "-m", "app.asr.server"]
