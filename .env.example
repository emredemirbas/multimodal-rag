# Local development only. Use a secret manager and generated credentials outside local Compose.
FRONTEND_PORT=3000
API_PORT=8000

# Used only by the local development identity adapter. Generate a unique value
# for your own .env file; never reuse it outside local development.
DEVELOPMENT_AUTH_TOKEN=replace-me

POSTGRES_DB=tutorial
POSTGRES_USER=tutorial
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5433

MINIO_ROOT_USER=tutorial
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

REDIS_PORT=6380

# Optional: official video/playlist metadata only, never audiovisual downloads.
# Uploading SRT/VTT transcripts does not require an external provider key.
YOUTUBE_API_KEY=

# Local safety limit: combined live ASR/indexing leases per playlist, between 1 and 4.
# Keep api, ingestion-worker and media-worker on the same value.
PLAYLIST_CONCURRENCY=2

# Default keyless demo. Optional real local generation: ollama (never a paid API).
# Start the local-ai Compose profile and explicitly download qwen3:4b first.
ANSWER_PROVIDER=extractive

# Optional multilingual semantic search. Explicitly install qwen3-embedding:0.6b
# and set EMBEDDING_PROVIDER=ollama for BOTH api and ingestion-worker.
# Existing sources need Reprocess; old citations stay inspectable.
EMBEDDING_PROVIDER=hash

# Experimental local WAV only (20 MB / 10 min / PCM16 / 16 kHz / mono).
# Install ASR weights explicitly and start local-asr before opting in. No paid fallback.
AUDIO_UPLOAD_ENABLED=false
# Experimental standalone MP4 OCR. Explicitly start local-visual and its worker.
# Does not enable audio transcription, arbitrary downloads or a video player.
VIDEO_UPLOAD_ENABLED=false
FRAME_DESCRIPTIONS_ENABLED=false
# Full manifest digest of the explicitly installed local qwen3.5:4b vision model.
# Leave empty while descriptions are disabled. No automatic download/fallback.
VISION_MODEL_DIGEST=
# New unpinned video jobs only: uniform (default) or experimental change-aware OCR.
# Existing generations keep their pinned profile; the native service stays credential-free.
VISUAL_SELECTION=uniform
